# ═══════════════════════════════════════════════════
# UCHINO — Plantilla de variables de entorno
# ═══════════════════════════════════════════════════
# Copia este archivo a `.env` y completa los valores reales.
# No commitear `.env` con secretos. Solo `.env.example` puede commitearse.
#
# Ver: docs_final/operacion/CREDENCIALES_Y_ACCESOS.md

# ─── Servidor principal ──────────────────────────────
PORT=3005
NODE_ENV=development

# ─── TTS Local (Piper / Kokoro) ─────────────────────
TTS_ENGINE=piper
PIPER_BIN=/usr/local/bin/piper
PIPER_MODEL=./models/piper/es_ES-davefx-medium.onnx
PIPER_CONFIG=./models/piper/es_ES-davefx-medium.onnx.json
PIPER_OUTPUT_RATE=22050

# ─── PostgreSQL ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chipi
POSTGRES_PASSWORD=
POSTGRES_DB=robot_mesero

# ─── Redis ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── ChromaDB (memoria vectorial) ──────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ─── InfluxDB (series temporales) ───────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=utec
INFLUX_BUCKET=robot_telemetry

# ─── Grafana ────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# ─── SQLite (operación en tiempo real) ──────────────
SQLITE_PATH=./data/robot_mesero.db

# ─── LLM (OpenRouter, primario) ─────────────────────
# Cascade actual:
#   texto:   deepseek/deepseek-v4-flash  (primario)
#            meta-llama/llama-3.1-8b-instruct  (fallback)
#   vision:  qwen/qwen3-vl-8b-instruct  →  deepseek v4 flash
#   offline: Ollama qwen3.5:9b local
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_VISION_MODEL=qwen/qwen3-vl-8b-instruct

# ─── LLM Local (Ollama, fallback offline) ───────────
OLLAMA_HOST=http://localhost:11434
QWEN35_9B_MODEL=qwen3.5:9b
QWEN35_9B_TIMEOUT_MS=30000

# ─── Cafetería UTEC ─────────────────────────────────
RESTAURANTE_NOMBRE="Cafetería UTEC"
RESTAURANTE_MESAS=20
ROBOT_NOMBRE=Uchino

# ─── ROS2 (CycloneDDS, dominio compartido) ──────────
ROS2_DOMAIN_ID=42
RPI5_ROS2_DOMAIN_ID=42
FOXGLOVE_BRIDGE_WS=ws://localhost:8765
VISION_CAPTURE_URL=http://<RPI5_HOST>:8765
VISION_MOCK=false

# ─── Red WiFi ESP32 ─────────────────────────────────
WIFI_SSID=robot_mesero_2.4G
WIFI_PASSWORD=
ESP32_WS_URL=ws://<LAPTOP_IP>:3005/ws/robot

# ─── RPi5 (SSH + bridge) ────────────────────────────
RPI5_HOST=
RPI5_USER=chipi
RPI5_PASSWORD=

# ─── GPU Manager (RTX 5000 16GB) ────────────────────
# Prioridad para evicción (mayor = crítico):
#   ASR(100) > Noise(90) > TTS(80) > SER(70) > Vision(60) > LLM-fallback(50)
GPU_MANAGER_MAX_VRAM_MB=16384
GPU_MANAGER_WARNING_THRESHOLD=0.9
GPU_MANAGER_MODEL_PRIORITIES=whisper_livekit:100,deepfilternet:90,kokoro:80,ser:70,vision:60,qwen3_14b:50

# ─── Seguridad ──────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=
JWT_SECRET=
