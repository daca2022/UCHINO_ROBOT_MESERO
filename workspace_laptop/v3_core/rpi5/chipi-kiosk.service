[Unit]
Description=Uchino Robot Mesero — Kiosk gráfico único (Surf, DSI 800x480)
Documentation=https://github.com/utec/robot-mesero
After=network-online.target getty@tty1.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=chipi
Group=gpio
WorkingDirectory=/home/chipi
EnvironmentFile=-/home/chipi/chipi_workspace_pln/v3_core/rpi5/kiosk.env
Environment=KIOSK_BROWSER=surf
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
ExecStart=/usr/bin/startx /home/chipi/chipi_workspace_pln/v3_core/rpi5/kiosk_start.sh -- :0 vt1 -keeptty -novtswitch
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
