/**
 * 🔊 CHIPI ESP32-Audio v3.0
 * WebSocket Binario + AudioCompass (TDoA) + I2S Estéreo
 *
 * Pinout ESTRICTO (NO ALTERAR):
 * I2S 0 (Entrada 2x INMP441):
 *   SCK  → GPIO 32
 *   WS   → GPIO 33
 *   SD   → GPIO 34
 * I2S 1 (Salida 2x MAX98357A):
 *   BCLK → GPIO 26
 *   LRC  → GPIO 25
 *   DOUT → GPIO 22
 *
 * MAX98357A SD_MODE (Configuración validada):
 *   Izquierdo: Libre (Sin resistencia)
 *   Derecho:   Resistencia en serie (330kΩ + 100kΩ = 430kΩ) hacia 5V
 *
 * AudioCompass: 2x INMP441 separados 14cm
 */

#include <Arduino.h>
#include <WiFi.h>
#include <ArduinoOTA.h>
#include <ArduinoWebsockets.h>
#include <driver/i2s.h>
#include <math.h>

// ── CALIBRACIÓN DE GANANCIA (VOLUMEN) ────────────────────────
// Ajusta estos valores si escuchas muy bajo o si un lado es más fuerte que el otro.
// 1.0 = Original, 2.0 = Doble volumen, 5.0 = Quintuple de volumen.
float GAIN_LEFT  = 1.0;  // Multiplicador para micrófono Izquierdo (L)
float GAIN_RIGHT = 3.0;  // Multiplicador para micrófono Derecho (R)

// ── CONFIGURACIÓN WIFI ───────────────────────────────────────
const char* WIFI_SSID = "robot_mesero_2.4G";
const char* WIFI_PASS = "";
const char* WS_HOST   = "192.168.1.2";  // IP de la laptop en la red robot_mesero
const int   WS_PORT   = 3003;
const char* WS_PATH   = "/ws/robot";

// ── PINOUT I2S ───────────────────────────────────────────────
#define I2S_MIC_SCK     32
#define I2S_MIC_WS      33
#define I2S_MIC_SD      34
#define I2S_SPK_BCLK    26
#define I2S_SPK_LRC     25
#define I2S_SPK_DOUT    22

// ── CONFIGURACIÓN AUDIO ──────────────────────────────────────
#define SAMPLE_RATE     16000
#define BUFFER_SAMPLES  512
#define WS_BUFFER_SIZE  (BUFFER_SAMPLES * 2 + 6)  // Header 6 bytes + PCM

// ── PROTOCOLO WS BINARIO ─────────────────────────────────────
#define MAGIC_BYTE      0xA5
#define TYPE_PCM_MONO   0x01
#define TYPE_PCM_STEREO 0x02
#define TYPE_COMPASS    0x03

// ── VARIABLES GLOBALES ───────────────────────────────────────
using namespace websockets;
WebsocketsClient wsClient;

int16_t micBuffer[BUFFER_SAMPLES];
int16_t spkBuffer[BUFFER_SAMPLES];
uint8_t wsTxBuffer[WS_BUFFER_SIZE];
uint8_t wsRxBuffer[WS_BUFFER_SIZE];

volatile bool wsConnected = false;
unsigned long lastReconnect = 0;
unsigned long lastHeartbeat = 0;
uint16_t packetSeq = 0;

// AudioCompass: buffers para TDoA
int16_t compassLeft[BUFFER_SAMPLES / 2];
int16_t compassRight[BUFFER_SAMPLES / 2];

// ── INICIALIZACIÓN I2S ───────────────────────────────────────
void initI2S() {
    // I2S 0: Micrófonos INMP441 (entrada estéreo)
    i2s_config_t i2sMicConfig = {
        .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_RX),
        .sample_rate = SAMPLE_RATE,
        .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
        .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
        .communication_format = I2S_COMM_FORMAT_STAND_I2S,
        .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
        .dma_buf_count = 8,
        .dma_buf_len = BUFFER_SAMPLES,
        .use_apll = false,
        .tx_desc_auto_clear = false,
        .fixed_mclk = 0
    };
    i2s_pin_config_t i2sMicPins = {
        .bck_io_num = I2S_MIC_SCK,
        .ws_io_num = I2S_MIC_WS,
        .data_out_num = I2S_PIN_NO_CHANGE,
        .data_in_num = I2S_MIC_SD
    };
    i2s_driver_install(I2S_NUM_0, &i2sMicConfig, 0, NULL);
    i2s_set_pin(I2S_NUM_0, &i2sMicPins);

    // I2S 1: Altavoces MAX98357A (salida estéreo)
    i2s_config_t i2sSpkConfig = {
        .mode = (i2s_mode_t)(I2S_MODE_MASTER | I2S_MODE_TX),
        .sample_rate = SAMPLE_RATE,
        .bits_per_sample = I2S_BITS_PER_SAMPLE_16BIT,
        .channel_format = I2S_CHANNEL_FMT_RIGHT_LEFT,
        .communication_format = I2S_COMM_FORMAT_STAND_I2S,
        .intr_alloc_flags = ESP_INTR_FLAG_LEVEL1,
        .dma_buf_count = 8,
        .dma_buf_len = BUFFER_SAMPLES,
        .use_apll = false,
        .tx_desc_auto_clear = true,
        .fixed_mclk = 0
    };
    i2s_pin_config_t i2sSpkPins = {
        .bck_io_num = I2S_SPK_BCLK,
        .ws_io_num = I2S_SPK_LRC,
        .data_out_num = I2S_SPK_DOUT,
        .data_in_num = I2S_PIN_NO_CHANGE
    };
    i2s_driver_install(I2S_NUM_1, &i2sSpkConfig, 0, NULL);
    i2s_set_pin(I2S_NUM_1, &i2sSpkPins);

    Serial.println("[I2S] Inicializado: 16kHz estéreo (Mic + Spk)");
}

// ── CONEXIÓN WIFI ────────────────────────────────────────────
void connectWiFi() {
    WiFi.mode(WIFI_STA);
    WiFi.begin(WIFI_SSID, WIFI_PASS);
    Serial.printf("[WiFi] Conectando a %s", WIFI_SSID);
    int retries = 0;
    while (WiFi.status() != WL_CONNECTED && retries < 30) {
        delay(500); Serial.print("."); retries++;
    }
    if (WiFi.status() == WL_CONNECTED) {
        Serial.printf(" OK  IP=%s\n", WiFi.localIP().toString().c_str());
    } else {
        Serial.println(" FAILED");
    }
}

// ── CONEXIÓN WEBSOCKET ───────────────────────────────────────
void connectWS() {
    if (wsConnected) return;
    if (millis() - lastReconnect < 3000) return;
    lastReconnect = millis();

    String url = String("ws://") + WS_HOST + ":" + WS_PORT + WS_PATH;
    Serial.printf("[WS] Conectando a %s\n", url.c_str());

    wsClient = WebsocketsClient();
    wsClient.onMessage([](WebsocketsMessage msg) {
        if (msg.isBinary()) {
            const uint8_t* data = (const uint8_t*)msg.c_str();
            if (data[0] == MAGIC_BYTE && data[1] == TYPE_PCM_STEREO) {
                uint16_t len = (data[4] << 8) | data[5];
                if (len <= BUFFER_SAMPLES * 2) {
                    memcpy(spkBuffer, data + 6, len);
                    size_t written;
                    i2s_write(I2S_NUM_1, spkBuffer, len, &written, portMAX_DELAY);
                }
            }
        }
    });
    wsClient.onEvent([](WebsocketsEvent event, String data) {
        if (event == WebsocketsEvent::ConnectionOpened) {
            wsConnected = true;
            Serial.println("[WS] Conectado");
        } else if (event == WebsocketsEvent::ConnectionClosed) {
            wsConnected = false;
            Serial.println("[WS] Desconectado");
        }
    });

    wsClient.connect(url);
}

// ── AUDIOCOMPASS (TDoA) ──────────────────────────────────────
float calculateTDoA() {
    // Separar canales izquierdo/derecho
    for (int i = 0; i < BUFFER_SAMPLES / 2; i++) {
        compassLeft[i] = micBuffer[i * 2];
        compassRight[i] = micBuffer[i * 2 + 1];
    }

    // Correlación cruzada para encontrar delay
    int maxDelay = 10;  // ~625us máximo a 14cm
    float maxCorr = 0;
    int bestDelay = 0;

    for (int delay = -maxDelay; delay <= maxDelay; delay++) {
        float corr = 0;
        int count = 0;
        for (int i = maxDelay; i < BUFFER_SAMPLES / 2 - maxDelay; i++) {
            int j = i + delay;
            corr += compassLeft[i] * compassRight[j];
            count++;
        }
        corr /= count;
        if (corr > maxCorr) {
            maxCorr = corr;
            bestDelay = delay;
        }
    }

    // Calcular ángulo aproximado
    // delay * (1/16000) * 343m/s / 0.14m → ángulo
    float angle = asinf((float)bestDelay / 16000.0f * 343.0f / 0.14f) * 180.0f / M_PI;
    return angle;
}

// ── ENVÍO AUDIO POR WS ───────────────────────────────────────
void sendAudioFrame() {
    if (!wsConnected) return;

    size_t bytesRead;
    i2s_read(I2S_NUM_0, micBuffer, BUFFER_SAMPLES * 2, &bytesRead, portMAX_DELAY);

    if (bytesRead == 0) return;

    // --- APLICAR GANANCIA DIGITAL Y CÁLCULO DE VOLUMEN ---
    double sumLeft = 0;
    double sumRight = 0;

    for (int i = 0; i < BUFFER_SAMPLES; i += 2) {
        // Canal Izquierdo
        int32_t sampleL = (int32_t)micBuffer[i] * GAIN_LEFT;
        if (sampleL > 32767) sampleL = 32767;
        if (sampleL < -32768) sampleL = -32768;
        micBuffer[i] = (int16_t)sampleL;
        sumLeft += (double)sampleL * sampleL;

        // Canal Derecho
        int32_t sampleR = (int32_t)micBuffer[i + 1] * GAIN_RIGHT;
        if (sampleR > 32767) sampleR = 32767;
        if (sampleR < -32768) sampleR = -32768;
        micBuffer[i + 1] = (int16_t)sampleR;
        sumRight += (double)sampleR * sampleR;
    }

    double rmsLeft = sqrt(sumLeft / (BUFFER_SAMPLES / 2));
    double rmsRight = sqrt(sumRight / (BUFFER_SAMPLES / 2));
    float dbLeft = 20.0 * log10(rmsLeft / 32768.0);
    float dbRight = 20.0 * log10(rmsRight / 32768.0);

    // Header binario
    wsTxBuffer[0] = MAGIC_BYTE;
    wsTxBuffer[1] = TYPE_PCM_STEREO;
    wsTxBuffer[2] = (packetSeq >> 8) & 0xFF;
    wsTxBuffer[3] = packetSeq & 0xFF;
    wsTxBuffer[4] = (bytesRead >> 8) & 0xFF;
    wsTxBuffer[5] = bytesRead & 0xFF;

    memcpy(wsTxBuffer + 6, micBuffer, bytesRead);
    wsClient.sendBinary((const char*)wsTxBuffer, 6 + bytesRead);

    packetSeq++;

    // Enviar AudioCompass cada 10 frames (~320ms)
    if (packetSeq % 10 == 0) {
        float angle = calculateTDoA();
        String metadata = String("{\"angle\":") + angle + String(",\"volL\":") + dbLeft + String(",\"volR\":") + dbRight + String(",\"seq\":") + packetSeq + String("}");
        uint16_t metaLen = metadata.length();

        wsTxBuffer[0] = MAGIC_BYTE;
        wsTxBuffer[1] = TYPE_COMPASS;
        wsTxBuffer[2] = (packetSeq >> 8) & 0xFF;
        wsTxBuffer[3] = packetSeq & 0xFF;
        wsTxBuffer[4] = (metaLen >> 8) & 0xFF;
        wsTxBuffer[5] = metaLen & 0xFF;
        memcpy(wsTxBuffer + 6, metadata.c_str(), metaLen);
        wsClient.sendBinary((const char*)wsTxBuffer, 6 + metaLen);
    }
}

// ── SETUP ────────────────────────────────────────────────────
void setup() {
    Serial.begin(115200);
    delay(500);
    Serial.println("\n═══════════════════════════════════════");
    Serial.println("  CHIPI ESP32-Audio v3.0");
    Serial.println("  WebSocket Binario + AudioCompass");
    Serial.println("═══════════════════════════════════════");

    connectWiFi();

    // Configuración OTA
    ArduinoOTA.setHostname("chipi-esp32-test");
    ArduinoOTA.setPassword("");
    ArduinoOTA.begin();

    initI2S();
    connectWS();
}

// ── LOOP ─────────────────────────────────────────────────────
void loop() {
    ArduinoOTA.handle();

    if (WiFi.status() != WL_CONNECTED) {
        connectWiFi();
    }
    if (!wsConnected) {
        connectWS();
    }

    wsClient.poll();
    sendAudioFrame();

    // Heartbeat cada 5 segundos
    if (millis() - lastHeartbeat > 5000) {
        lastHeartbeat = millis();
        if (wsConnected) {
            wsClient.send("{\"type\":\"heartbeat\",\"timestamp\":" + String(millis()) + "}");
        }
    }
}
