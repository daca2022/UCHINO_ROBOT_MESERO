# ═══════════════════════════════════════════════════
# PLANTILLA LEGACY — NO USAR PARA LA INSTALACIÓN PÚBLICA
# ═══════════════════════════════════════════════════
# La plantilla canónica es ../../.env.example desde esta carpeta.
# La guía actual está en ../../../../docs/GUIA_PUBLICA.md y GUIA_VOZ.md.
# Este archivo se conserva por compatibilidad histórica; contiene variables
# de componentes antiguos que no forman parte del arranque público.
# Copiar a .env y rellenar con valores reales.
# Las credenciales reales están en shared/credentials/CREDENTIALS.md

# ─── API Keys ───────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ─── Modo IA ────────────────────────────────────────
# 'hermes' = local (vLLM + Hermes-3 + Piper TTS) | 'gemini' = cloud (requiere API key)
AI_MODE=hermes

# ─── OpenClaw Agent ─────────────────────────────────
OPENCLAW_URL=http://localhost:8010
OPENCLAW_PORT=8010

# ─── vLLM (Hermes-3 local) ──────────────────────────
VLLM_URL=http://localhost:8000/v1/chat/completions
VLLM_MODEL=solidrust/Hermes-3-Llama-3.1-8B-AWQ

# ─── TTS Local (Piper) ──────────────────────────────
TTS_ENGINE=piper
PIPER_BIN=./venv/bin/piper
PIPER_MODEL=./models/piper/es_ES-davefx-medium.onnx
PIPER_CONFIG=./models/piper/es_ES-davefx-medium.onnx.json
PIPER_OUTPUT_RATE=22050

# ─── PostgreSQL ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=chipi
POSTGRES_PASSWORD=YOUR_PG_PASSWORD
POSTGRES_DB=robot_mesero

# ─── Redis ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── ChromaDB ───────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ─── InfluxDB ───────────────────────────────────────
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=YOUR_INFLUX_TOKEN
INFLUX_ORG=utec
INFLUX_BUCKET=robot_telemetry

# ─── Grafana ────────────────────────────────────────
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=YOUR_GRAFANA_PASSWORD

# ─── Servidor principal ─────────────────────────────
PORT=3003
NODE_ENV=development

# ─── Node-RED ───────────────────────────────────────
NODERED_PORT=1880
NODERED_USER_DIR=./nodered

# ─── Visión / YOLO ──────────────────────────────────
VISION_PORT=5001
VISION_CAMERA_INDEX=1
VISION_CAMERA_CANDIDATES=1,2,0,3
VISION_MODEL=yolov8n.pt
FACE_DB_PATH=./vision/face_db/caras.db

# ─── Cloudflare Tunnel (opcional) ───────────────────
CLOUDFLARE_TUNNEL_TOKEN=YOUR_CLOUDFLARE_TUNNEL_TOKEN

# ─── Wake Word (Picovoice Porcupine) ────────────────
PICOVOICE_ACCESS_KEY=YOUR_PICOVOICE_ACCESS_KEY
PORCUPINE_KEYWORD_PATH=
AUDIO_DEVICE_INDEX=-1

# ─── Modelo Gemini ──────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_VOICE=Puck

# ─── Cafetería UTEC ─────────────────────────────────
RESTAURANTE_NOMBRE=Cafetería UTEC
RESTAURANTE_MESAS=20
ROBOT_NOMBRE=Chipi

# ─── Seguridad ──────────────────────────────────────
JWT_SECRET=YOUR_JWT_SECRET
